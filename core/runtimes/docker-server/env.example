# Docker-server runtime configuration. Copy to .env — NEVER commit .env.

# The repo your agents are installed in (the installer's target repo).
GITHUB_REPO=owner/name
# Fine-grained PAT for that repo: contents read+write (state branch, checkouts),
# plus pull-requests/issues write if your recipes open PRs or issues.
GITHUB_PAT=

# Brain auth — set what your chosen brain needs (see scripts/*-agent/ai/brain.sh).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tool API tokens — same names the GitHub Actions secrets used
# (only the ones your installed agents need).
#CLICKUP_TOKEN=
#JIRA_EMAIL=
#JIRA_API_TOKEN=
#ZENDESK_EMAIL=
#ZENDESK_API_TOKEN=
# ...

# Relay verification secrets — same names the Cloudflare Worker secrets used
# (each agent's relay/wrangler.toml comments list them).
#CLICKUP_WEBHOOK_SECRET=
#WEBHOOK_SECRET=
#ASANA_HOOK_SECRET=
# ...
