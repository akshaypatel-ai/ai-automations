name = "{{WORKER_NAME}}"
main = "worker.js"
compatibility_date = "2024-11-01"

# Secrets (set with `wrangler secret put`):
#   GITHUB_PAT               fine-grained PAT scoped to {{GITHUB_REPO}} only, contents: read+write
#   SHORTCUT_WEBHOOK_SECRET  the secret you type into the webhook form (Settings → API → Webhooks)

[vars]
GITHUB_REPO = "{{GITHUB_REPO}}"
ENABLED_HANDLERS = "{{HANDLERS}}"
AGENT_MARKER = "{{AGENT_MARKER}}"

# Optional — retarget the doorbell to another runtime (default: GitHub Actions; see core/runtimes/):
# DISPATCH_KIND = "gitlab"     # + GITLAB_TRIGGER_URL / GITLAB_REF vars, GITLAB_TRIGGER_TOKEN secret
# DISPATCH_KIND = "bitbucket"  # + BITBUCKET_WORKSPACE / BITBUCKET_REPO vars, BITBUCKET_TOKEN secret
