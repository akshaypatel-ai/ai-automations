#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Shortcut project agent.
# Override any value via the environment. SHORTCUT_TOKEN comes from CI secrets.

# Workflow-state NAMES (Shortcut's board columns). Stories carry a numeric
# workflow_state_id — the resolver maps it to its name via /workflows and
# matches case-insensitively.
export STATE_ANALYZE="${STATE_ANALYZE:-{{STATE_ANALYZE}}}"
export STATE_IMPLEMENT="${STATE_IMPLEMENT:-{{STATE_IMPLEMENT}}}"
# Enabled handlers (comma-separated). Fully implemented: stories.
# epics/iterations are routed by the relay but skipped by the resolver
# until their playbooks land — enabling them is harmless, just inert.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export CLAUDE_MODEL="${CLAUDE_MODEL:-{{CLAUDE_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-shortcut-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
