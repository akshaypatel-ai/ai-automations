name: Rocket.Chat Notify Agent

# Mostly relay-free: `ship` and `incident` use GitHub-native triggers.
# `ask` arrives via the token-verified outgoing-webhook relay as repository_dispatch.
on:
  release:
    types: [ published ]
  workflow_run:
    workflows: [{{INCIDENT_WORKFLOWS}}]
    types: [ completed ]
  repository_dispatch:
    types: [ rocketchat_event ]
  workflow_dispatch:
    inputs:
      mode:
        description: 'ship | incident | ask (manual test)'
        required: true
        default: 'ship'

permissions:
  contents: read
  actions: read

concurrency:
  group: rocketchat-agent-${{ github.event_name }}-${{ github.run_id }}
  cancel-in-progress: false

jobs:
  agent:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Ignore successful workflow_run events — only failures notify.
    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'failure'
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      ROCKETCHAT_WEBHOOK_URL: ${{ secrets.ROCKETCHAT_WEBHOOK_URL }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install AI brain
        run: bash -c 'source scripts/rocketchat-agent/ai/brain.sh && ai_install'

      - name: Run agent
        env:
          RELEASE_TAG: ${{ github.event.release.tag_name }}
          WF_NAME: ${{ github.event.workflow_run.name }}
          WF_URL: ${{ github.event.workflow_run.html_url }}
          WF_RUN_ID: ${{ github.event.workflow_run.id }}
          ASK_TEXT: ${{ github.event.client_payload.text }}
        run: |
          [ -n "$ROCKETCHAT_WEBHOOK_URL" ] || { echo "::error::Set repo secret ROCKETCHAT_WEBHOOK_URL (Rocket.Chat incoming webhook URL)."; exit 1; }
          ANTHROPIC_API_KEY="$(printf '%s' "${ANTHROPIC_API_KEY:-}" | tr -d '[:space:]')"
          CLAUDE_CODE_OAUTH_TOKEN="$(printf '%s' "${CLAUDE_CODE_OAUTH_TOKEN:-}" | tr -d '[:space:]')"
          [ -z "$ANTHROPIC_API_KEY" ] && unset ANTHROPIC_API_KEY
          [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && unset CLAUDE_CODE_OAUTH_TOKEN
          OPENAI_API_KEY="$(printf '%s' "${OPENAI_API_KEY:-}" | tr -d '[:space:]')"
          GEMINI_API_KEY="$(printf '%s' "${GEMINI_API_KEY:-}" | tr -d '[:space:]')"
          [ -z "$OPENAI_API_KEY" ] && unset OPENAI_API_KEY
          [ -z "$GEMINI_API_KEY" ] && unset GEMINI_API_KEY
          if ! bash -c 'source scripts/rocketchat-agent/ai/brain.sh && ai_check'; then
            echo "::error::Brain auth/deps check failed — set the secret(s) named above."
            exit 1
          fi
          case "${{ github.event_name }}" in
            release)             MODE=ship ;;
            workflow_run)        MODE=incident ;;
            repository_dispatch) MODE=ask ;;
            workflow_dispatch)   MODE="${{ inputs.mode }}" ;;
          esac
          export MODE
          bash scripts/rocketchat-agent/agent-run.sh

      - name: Upload agent output
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: agent-output-${{ github.run_id }}
          path: .agent-out/
          if-no-files-found: ignore
