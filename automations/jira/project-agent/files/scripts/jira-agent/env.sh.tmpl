#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Jira project agent.
# Override any value via the environment. JIRA_EMAIL/JIRA_API_TOKEN come from CI secrets.

export JIRA_SITE="${JIRA_SITE:-{{JIRA_SITE}}}"
export JIRA_PROJECT_KEY="${JIRA_PROJECT_KEY:-{{JIRA_PROJECT_KEY}}}"
# Status DISPLAY NAMES — the analyze status and the implement status.
export STATUS_ANALYZE="${STATUS_ANALYZE:-{{STATUS_ANALYZE}}}"
export STATUS_IMPLEMENT="${STATUS_IMPLEMENT:-{{STATUS_IMPLEMENT}}}"
# Enabled handlers (comma-separated). Fully implemented: issues.
# sprints/versions/worklogs are routed by the relay but skipped by the
# resolver until their playbooks land — enabling them is harmless, just inert.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export CLAUDE_MODEL="${CLAUDE_MODEL:-{{CLAUDE_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-jira-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
