#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Airtable project agent.
# Override any value via the environment. AIRTABLE_TOKEN comes from CI secrets.

export AIRTABLE_BASE_ID="${AIRTABLE_BASE_ID:-{{AIRTABLE_BASE_ID}}}"
export AIRTABLE_TABLE_ID="${AIRTABLE_TABLE_ID:-{{AIRTABLE_TABLE_ID}}}"
# Field NAMES (not ids). The status field may be a single select or a
# status-type field — both are handled; option matching is case-insensitive.
export STATUS_FIELD="${STATUS_FIELD:-{{STATUS_FIELD}}}"
export TITLE_FIELD="${TITLE_FIELD:-{{TITLE_FIELD}}}"
export STATUS_ANALYZE="${STATUS_ANALYZE:-{{STATUS_ANALYZE}}}"
export STATUS_IMPLEMENT="${STATUS_IMPLEMENT:-{{STATUS_IMPLEMENT}}}"
# Webhook id (ach… — empty until the webhook is created; every agent run then
# refreshes it best-effort so it survives Airtable's 7-day expiry).
export AIRTABLE_WEBHOOK_ID="${AIRTABLE_WEBHOOK_ID:-{{AIRTABLE_WEBHOOK_ID}}}"
# Enabled handlers (comma-separated). Fully implemented: records — the only
# family Airtable's detail-free pings can wake; the reconcile does the routing.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export CLAUDE_MODEL="${CLAUDE_MODEL:-{{CLAUDE_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-airtable-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
