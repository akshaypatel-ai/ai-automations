# Override any value via the environment. MONDAY_TOKEN comes from CI secrets.

export MONDAY_BOARD_ID="${MONDAY_BOARD_ID:-{{MONDAY_BOARD_ID}}}"
# The status column's id (Board → column menu → Settings → Customize … shows it;
# the default status column id is "status").
export STATUS_COLUMN_ID="${STATUS_COLUMN_ID:-{{STATUS_COLUMN_ID}}}"
# Status LABELS (matching is case-insensitive).
export STATUS_ANALYZE="${STATUS_ANALYZE:-{{STATUS_ANALYZE}}}"
