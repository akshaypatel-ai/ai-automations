name = "{{WORKER_NAME}}"
main = "worker.js"
compatibility_date = "2024-11-01"

# Secrets (set with `wrangler secret put`):
#   GITHUB_PAT          fine-grained PAT scoped to {{GITHUB_REPO}} only, contents: read+write
#   NETLIFY_JWS_SECRET  the JWS secret YOU chose (e.g. `openssl rand -hex 24`) —
#                       the SAME value entered in the deploy-notification form

[vars]
GITHUB_REPO = "{{GITHUB_REPO}}"
ENABLED_HANDLERS = "{{HANDLERS}}"
# Optional: a Netlify site id (API ID) — deliveries for other sites are dropped
# at the edge. Empty forwards every site whose notifications point here.
WATCHED_SITE = "{{NETLIFY_SITE_ID}}"
