#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Netlify deploy agent.
# Override any value via the environment. NETLIFY_TOKEN comes from CI secrets.

# Site ID (API ID) — Site configuration → Site details; scopes reconcile scans
# and the workflow's auth check to this site.
export NETLIFY_SITE_ID="${NETLIFY_SITE_ID:-{{NETLIFY_SITE_ID}}}"
# Label applied to every GitHub issue the agent files.
export ISSUE_LABEL="${ISSUE_LABEL:-{{ISSUE_LABEL}}}"
# Enabled handlers (comma-separated). Fully implemented: deploys.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export AI_BRAIN="${AI_BRAIN:-{{BRAIN_NAME}}}"
export AI_MODEL="${AI_MODEL:-{{AI_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-netlify-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
