#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Vercel deploy agent.
# Override any value via the environment. VERCEL_TOKEN comes from CI secrets.

# Team id — empty for personal accounts; when set, api.sh appends it as teamId=.
export VERCEL_TEAM_ID="${VERCEL_TEAM_ID:-{{VERCEL_TEAM_ID}}}"
# Project id — empty watches every project the token can see.
export VERCEL_PROJECT_ID="${VERCEL_PROJECT_ID:-{{VERCEL_PROJECT_ID}}}"
# Label applied to every GitHub issue the agent files.
export ISSUE_LABEL="${ISSUE_LABEL:-{{ISSUE_LABEL}}}"
# Enabled handlers (comma-separated). Fully implemented: deployments.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export AI_BRAIN="${AI_BRAIN:-{{BRAIN_NAME}}}"
export AI_MODEL="${AI_MODEL:-{{AI_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-vercel-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
