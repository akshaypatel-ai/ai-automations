#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the PagerDuty triage agent.
# Override any value via the environment. PAGERDUTY_TOKEN comes from CI secrets.

# The PagerDuty user every note is attributed to (the REST API's From: header).
# An email is configuration, not a secret — any real user on the account works.
export PAGERDUTY_FROM_EMAIL="${PAGERDUTY_FROM_EMAIL:-{{PAGERDUTY_FROM_EMAIL}}}"
# Enabled handlers (comma-separated). Fully implemented: incidents.
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export CLAUDE_MODEL="${CLAUDE_MODEL:-{{CLAUDE_MODEL}}}"
export STATE_BRANCH="${STATE_BRANCH:-pagerduty-agent-state}"
export STATE_DIR="${STATE_DIR:-.agent-state}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
