# Override any value via the environment. CLICKUP_TOKEN comes from CI secrets.

export CLICKUP_TEAM_ID="${CLICKUP_TEAM_ID:-{{CLICKUP_TEAM_ID}}}"
export CLICKUP_LIST_ID="${CLICKUP_LIST_ID:-{{CLICKUP_LIST_ID}}}"
# Status NAMES (ClickUp statuses are usually lowercase; matching is case-insensitive).
export STATUS_ANALYZE="${STATUS_ANALYZE:-{{STATUS_ANALYZE}}}"
export STATUS_IMPLEMENT="${STATUS_IMPLEMENT:-{{STATUS_IMPLEMENT}}}"
# Enabled handlers (comma-separated). Fully implemented: tasks.
