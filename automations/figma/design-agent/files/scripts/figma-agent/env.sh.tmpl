#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Figma design agent.
# Override any value via the environment. FIGMA_TOKEN comes from CI secrets.

# Comments starting with this prefix summon the agent (Figma can't @mention a bot).
export TRIGGER="${TRIGGER:-{{TRIGGER}}}"
# File key to watch (empty = every file the webhook's team emits).
export WATCHED_FILE="${WATCHED_FILE:-{{WATCHED_FILE}}}"
# Enabled handlers (comma-separated): comments
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_NAME="${AGENT_NAME:-{{AGENT_NAME}}}"
# Every reply starts with this marker — it's also the relay's loop protection.
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export AI_BRAIN="${AI_BRAIN:-{{BRAIN_NAME}}}"
export AI_MODEL="${AI_MODEL:-{{AI_MODEL}}}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
