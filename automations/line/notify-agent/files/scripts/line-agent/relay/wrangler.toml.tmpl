name = "{{WORKER_NAME}}"
main = "worker.js"
compatibility_date = "2024-11-01"

# Only needed for the `ask` handler — ship/incident use GitHub-native triggers.
# Secrets (set with `wrangler secret put`):
#   GITHUB_PAT           fine-grained PAT scoped to {{GITHUB_REPO}} only, contents: read+write
#   LINE_CHANNEL_SECRET  from the LINE Developers console (Basic settings)

[vars]
GITHUB_REPO = "{{GITHUB_REPO}}"
WATCHED_TARGET = "{{LINE_TARGET_ID}}"
