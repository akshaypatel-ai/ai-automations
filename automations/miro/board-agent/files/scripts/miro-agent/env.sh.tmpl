#!/usr/bin/env bash
# Generated by ai-automations — shared constants for the Miro board agent.
# Override any value via the environment. MIRO_TOKEN comes from CI secrets.

# The watched board — the id after /app/board/ in the URL (opaque base64;
# keep the trailing '=', it's valid in URL paths as-is).
export MIRO_BOARD_ID="${MIRO_BOARD_ID:-{{MIRO_BOARD_ID}}}"
# Sticky notes starting with this prefix summon the agent.
export TRIGGER="${TRIGGER:-{{TRIGGER}}}"
# Enabled handlers (comma-separated): stickies
export ENABLED_HANDLERS="${ENABLED_HANDLERS:-{{HANDLERS}}}"
export AGENT_NAME="${AGENT_NAME:-{{AGENT_NAME}}}"
# Every reply sticky starts with this marker — it's also the relay's echo protection.
export AGENT_MARKER="${AGENT_MARKER:-{{AGENT_MARKER}}}"
export AI_BRAIN="${AI_BRAIN:-{{BRAIN_NAME}}}"
export AI_MODEL="${AI_MODEL:-{{AI_MODEL}}}"
export OUT_DIR="${OUT_DIR:-.agent-out}"
